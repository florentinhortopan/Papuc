# --- Public (sent to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Canonical public origin (share links, server absolute URLs).
# Production: https://papuc.app — local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only ---
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI Realtime — Papuc Voice Concierge (WebRTC). Server-only; browsers
# receive short-lived ephemeral client secrets from /api/voice/session.
OPENAI_API_KEY=sk-...
# Optional overrides (defaults: gpt-realtime / marin)
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Real-estate provider — set ONE.
# Preferred: HasData (Zillow scraper). Get a key at https://app.hasdata.com.
# Each scout costs ~5 credits per 25 candidates.
HASDATA_API_KEY=

# Legacy fallback. Used only if HASDATA_API_KEY is empty.
REALESTATEAPI_KEY=

# Optional: AirROI (airroi.com/api) — comps-based STR revenue estimates.
# Pay-as-you-go, $10 minimum deposit; the deal page's "Get market estimate"
# button costs $0.20 per click and is cached on the deal afterwards.
AIRROI_API_KEY=

# Any random string. Vercel Cron sends this in the Authorization header.
CRON_SECRET=replace-me-with-random-string

# Resend (nightly Pro scout digests). Domain must be verified in Resend.
RESEND_API_KEY=re_...
# e.g. Papuc <alerts@papuc.app>
EMAIL_FROM=Papuc <alerts@papuc.app>
